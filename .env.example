# Settings for one Cards instance. `./cards setup` copies this file to .env and fills in what it
# can. To change a setting later, edit .env and run `./cards up`.

# ─── Release ──────────────────────────────────────────────────────────────────
# Version running here. Setup picks the newest release; `./cards update` and auto-update rewrite it.
CARDS_VERSION=
# Where the cards-next, cards-ws and cards-proxy images are published (must be lowercase).
CARDS_IMAGE_PREFIX=ghcr.io/mikem2343/cards

# ─── Auto-update ──────────────────────────────────────────────────────────────
# true: install each new release as soon as the Cards publish workflow announces it.
CARDS_AUTO_UPDATE=false
# ntfy server and topic the publish workflow announces releases on.
CARDS_UPDATE_SERVER=https://ntfy.sh
CARDS_UPDATE_TOPIC=cards-releases-fc544e0257c4a4b9
# Access token, only needed if your ntfy server requires one to read the topic.
CARDS_UPDATE_TOKEN=

# ─── Instance ─────────────────────────────────────────────────────────────────
# Public hostname players use. Sign-in emails link to https://<APP_DOMAIN>.
APP_DOMAIN=
# Host port the proxy listens on. It is the only port players need.
APP_MAIN_PORT=4004
# Host port for MongoDB admin tools. Only reachable from this machine (bound to 127.0.0.1).
MONGODB_HOST_PORT=27218

# ─── Secrets ──────────────────────────────────────────────────────────────────
# Generated by setup.
Secret=
MONGO_INITDB_ROOT_PASSWORD=
# Gmail account that sends sign-in emails, and a Gmail app password for it (not the account password).
EmailAccount=
EmailPassword=
# Sender shown on sign-in emails. Empty uses EmailAccount.
EMAIL_FROM=
# Required as x-metrics-token on /metrics/game. Empty leaves those endpoints open.
GAME_METRICS_TOKEN=

# ─── Written by ./cards ───────────────────────────────────────────────────────
# Instance name, used as the container name prefix. Setup uses this directory's name.
COMPOSE_PROJECT_NAME=
# Absolute path of this directory, so the updater container can mount it at the same path.
CARDS_DIR=
