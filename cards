#!/usr/bin/env bash
# Sets up and runs a Cards instance from the published images. Run `./cards help` for the commands.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"
source lib/config.sh

readonly AppServices=(mongodb ws next proxy)

die() {
	echo "cards: $*" >&2
	exit 1
}

usage() {
	cat <<'EOF'
Usage: ./cards <command>

  setup                      Create .env (asking for anything missing), then start Cards
  up                         Start Cards, or apply changes made to .env
  down                       Stop Cards (data is kept)
  update [version] [--force] Install the newest release, or the given one; --force allows downgrades
  status                     Show the running version and containers
  logs [service]             Follow logs (services: proxy, next, ws, mongodb, updater)
EOF
}

checkPrerequisites() {
	command -v docker >/dev/null || die "Docker is not installed (https://docs.docker.com/engine/install/)"
	docker compose version >/dev/null 2>&1 || die "The Docker Compose plugin is not installed"
	command -v curl >/dev/null || die "curl is not installed"
	docker info >/dev/null 2>&1 || die "Cannot reach Docker. Is it running, and can this user use it?"
}

requireEnvFile() {
	[[ -f $EnvFile ]] || die "No .env yet; run ./cards setup first"
}

randomSecret() {
	head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
}

# Prompts for a setting that .env leaves empty, or fails when there is no terminal to ask on.
askIfUnset() {
	local key=$1 prompt=$2 value=
	[[ -z $(getConfig "$key") ]] || return 0
	[[ -t 0 ]] || die "Set $key in .env, then run ./cards setup again"
	while [[ -z $value ]]; do
		if [[ ${3:-} == --secret ]]; then
			read -rsp "$prompt: " value
			echo
			# Gmail shows app passwords in groups of four; the spaces are not part of them.
			value=${value// /}
		else
			read -rp "$prompt: " value
		fi
	done
	setConfig "$key" "$value"
}

# Newest release whose next, ws and proxy images have all been published.
latestVersion() {
	local prefix registry image repository token
	prefix=$(getConfig CARDS_IMAGE_PREFIX)
	registry=${prefix%%/*}
	for image in cards-next cards-ws cards-proxy; do
		repository=${prefix#*/}/$image
		# GHCR wants a token even for public images; an anonymous one can read the tags.
		token=$(curl -fsS "https://$registry/token?scope=repository:$repository:pull" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
		curl -fsS -H "Authorization: Bearer $token" "https://$registry/v2/$repository/tags/list?n=10000" |
			grep -oE '"v[0-9]+\.[0-9]+\.[0-9]+"' | tr -d '"'
	done | sort | uniq -c | awk '$1 == 3 { print $2 }' | sort -V | tail -n 1
}

requireLatestVersion() {
	local version
	version=$(latestVersion) && [[ -n $version ]] ||
		die "Could not find a release under $(getConfig CARDS_IMAGE_PREFIX); set CARDS_VERSION in .env"
	echo "$version"
}

setup() {
	local key version
	checkPrerequisites
	if [[ ! -f $EnvFile ]]; then
		cp .env.example "$EnvFile"
		chmod 600 "$EnvFile"
		# Settings exported in the environment are used as given, which allows unattended setup.
		for key in $(sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' .env.example); do
			if [[ -n ${!key:-} ]]; then
				setConfig "$key" "${!key}"
			fi
		done
		echo "Created .env"
	fi

	if [[ -z $(getConfig COMPOSE_PROJECT_NAME) ]]; then
		setConfig COMPOSE_PROJECT_NAME "$(basename "$(pwd -P)" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' '-')"
	fi
	for key in Secret MONGO_INITDB_ROOT_PASSWORD; do
		if [[ -z $(getConfig "$key") ]]; then
			setConfig "$key" "$(randomSecret)"
		fi
	done
	askIfUnset APP_DOMAIN 'Public hostname players will use (e.g. cards.example.com)'
	askIfUnset EmailAccount 'Gmail address that sends sign-in emails'
	askIfUnset EmailPassword 'Gmail app password for that address' --secret
	if [[ -z $(getConfig CARDS_VERSION) ]]; then
		version=$(requireLatestVersion)
		setConfig CARDS_VERSION "$version"
	fi
	up
}

up() {
	checkPrerequisites
	requireEnvFile
	setConfig CARDS_DIR "$(pwd -P)"
	mkdir -p "$StateDir"
	docker compose up -d "${AppServices[@]}"
	if [[ $(getConfig CARDS_AUTO_UPDATE) == true ]]; then
		docker compose up -d updater
	else
		docker compose --profile autoupdate rm --stop --force updater >/dev/null 2>&1 || true
	fi
	echo "Waiting for Cards to answer..."
	docker compose run --rm updater health || die "Cards did not become healthy; see ./cards logs"
	status
}

update() {
	local arg version='' force=''
	for arg in "$@"; do
		if [[ $arg == --force ]]; then
			force=--force
		else
			version=$arg
		fi
	done
	checkPrerequisites
	requireEnvFile
	if [[ -z $version ]]; then
		version=$(requireLatestVersion)
	fi
	docker compose run --rm updater deploy "$version" ${force:+"$force"}
}

status() {
	requireEnvFile
	local autoUpdate=off
	if [[ $(getConfig CARDS_AUTO_UPDATE) == true ]]; then
		autoUpdate="on (topic $(getConfig CARDS_UPDATE_TOPIC))"
	fi
	echo
	echo "Version:     $(getConfig CARDS_VERSION)"
	echo "Auto-update: $autoUpdate"
	echo "Address:     https://$(getConfig APP_DOMAIN) (proxy on port $(getConfig APP_MAIN_PORT))"
	echo
	docker compose --profile autoupdate ps
}

case ${1:-help} in
	setup) setup ;;
	up) up ;;
	down) docker compose --profile autoupdate down ;;
	update) update "${@:2}" ;;
	status) status ;;
	logs) docker compose --profile autoupdate logs -f --tail=100 "${@:2}" ;;
	*) usage ;;
esac
